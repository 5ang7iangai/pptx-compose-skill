  "type": "object",
  "required": [
    "brief",
    "bbox"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "brief": {
      "type": "string"
    },
    "layout": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "bbox": {
      "type": "object",
      "required": [
        "l",
        "t",
        "w",
        "h"
      ]
    }
  }
}